# ============================================================
# BUDGETBUDDY BACKEND CONFIGURATION
# ============================================================

DJANGO_DEBUG=True
DJANGO_SECRET_KEY=your-secure-random-secret-key-here
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Google OAuth 2.0 Client ID
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# PostgreSQL Database Configuration
DB_NAME=budgetbuddy_db
DB_USER=postgres
DB_PASSWORD=your-database-password
DB_HOST=localhost
DB_PORT=5432

# CORS & CSRF Trusted Origins
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173

# Authentication Cookie Settings
AUTH_COOKIE_ACCESS=budgetbuddy_access
AUTH_COOKIE_REFRESH=budgetbuddy_refresh
AUTH_COOKIE_HTTP_ONLY=True
AUTH_COOKIE_SECURE=False
AUTH_COOKIE_SAMESITE=Lax

# Email / SMTP Notification Settings
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-16-character-app-password
DEFAULT_FROM_EMAIL=your-email@gmail.com
